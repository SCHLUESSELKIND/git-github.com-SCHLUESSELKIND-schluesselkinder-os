# SCHLUESSELKINDER public web — environment template.
# Copy to .env.local (development) or set in your hosting platform (Vercel /
# Hetzner / etc.) for production. NEVER commit a real .env file.

# ---------------------------------------------------------------------------
# SNUFFRAGGA SOUNDSYSTEM — /artists/snuffragga
# Operator wires real iframe `src` URLs from Spotify for Artists and SoundCloud
# Embed. If either is empty, the page renders an honest "transmission offline"
# placeholder. No fake URLs are baked in.
#
# Consent: both embeds are consent-gated. Even when URLs are configured, the
# iframe is NOT rendered until the visitor clicks "Signal laden". Consent
# is stored in localStorage under `sk_embed_consent` and applies to all
# music embeds on the same domain. No cookies are set by our code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SNUFFRAGGA_SPOTIFY_EMBED=
# Production value (set in your hosting env panel, NOT committed):
#   https://open.spotify.com/embed/artist/0Gt1TrN8G1DyXBa2Da5XLW?utm_source=generator

NEXT_PUBLIC_SNUFFRAGGA_SOUNDCLOUD_EMBED=
# Production value (set in your hosting env panel, NOT committed):
#   https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/thomas-frerich-681624781%3Futm_source%3Dclipboard%26utm_medium%3Dtext%26utm_campaign%3Dsocial_sharing

# ---------------------------------------------------------------------------
# Newsletter — SIGNAL form
# Operator wires this to the public subscribe route in the inference service:
#   POST /v1/public/newsletter/subscribe
# If empty, the NewsletterForm renders but submission fails with an honest
# offline state — we never POST to a placeholder URL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
# Example: https://api.schluesselkinder.de/v1/public/newsletter/subscribe
#
# Backend behaviour:
# - The subscribe route always returns honestly: SUBSCRIBED / PENDING /
#   OFFLINE / FAILED. It NEVER fakes success.
# - When Listmonk is not configured on the inference service side, the
#   route still returns 200 with status="offline" so the UI can render the
#   honest "signal endpoint offline" state.
# - The raw email is NEVER echoed in the response — only sha256 hash.
#
# Listmonk wiring (server-side, in the inference service env):
#   SOUNDSYSTEM_LISTMONK_BASE_URL=https://listmonk.your-host.tld
#   SOUNDSYSTEM_LISTMONK_USERNAME=api_user
#   SOUNDSYSTEM_LISTMONK_PASSWORD=<api_token>
#   SOUNDSYSTEM_LISTMONK_LIST_ID=<numeric_list_id>
# All four are required for live subscribe. Missing any one keeps the route
# in offline mode (no upstream call is made).

# ---------------------------------------------------------------------------
# Shop — Shopify storefront for GRÜNLICHTBEZIRK objects
# Defaults to local /shop. Set to the live Shopify domain once DNS + Shopify
# are connected (see apps/shopify-theme/README.md).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SHOP_URL=https://shop.schluesselkinder.de
