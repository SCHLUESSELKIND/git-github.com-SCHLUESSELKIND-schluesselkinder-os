<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}{% if current_tags %} &mdash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &mdash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &mdash; {{ shop.name }}{% endunless %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'seo' %}

    {{ content_for_header }}

    {%- assign display_font = settings.font_display | default: settings.type_header_font -%}
    {%- assign body_font = settings.font_body | default: settings.type_body_font -%}
    {%- assign mono_font = settings.font_mono | default: settings.type_body_font -%}

    {{ display_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ mono_font | font_face: font_display: 'swap' }}

    <style>
      :root {
        --bg: {{ settings.color_bg }};
        --fg: {{ settings.color_fg }};
        --muted: {{ settings.color_muted }};
        --accent: {{ settings.color_accent }};
        --border: {{ settings.color_border }};
        --page-max: {{ settings.page_max_width }}px;
        --tracking-display: {{ settings.display_tracking | divided_by: 1000.0 }}em;
        --font-display: {{ display_font.family }}, {{ display_font.fallback_families }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-mono: {{ mono_font.family }}, {{ mono_font.fallback_families }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.classList.remove('no-js');</script>
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }}{% if settings.grain %} body--grain{% endif %}">
    <a class="skip-to-content-link" href="#main-content">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
