<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }} — Closed signal</title>

    {%- assign display_font = settings.font_display | default: settings.type_header_font -%}
    {%- assign body_font = settings.font_body | default: settings.type_body_font -%}
    {%- assign mono_font = settings.font_mono | default: settings.type_body_font -%}
    {{ display_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ mono_font | font_face: font_display: 'swap' }}

    <style>
      :root {
        --bg: {{ settings.color_bg }};
        --fg: {{ settings.color_fg }};
        --muted: {{ settings.color_muted }};
        --accent: {{ settings.color_accent }};
        --border: {{ settings.color_border }};
        --font-display: {{ display_font.family }}, {{ display_font.fallback_families }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-mono: {{ mono_font.family }}, {{ mono_font.fallback_families }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main style="min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:48px 24px;text-align:center;gap:32px;">
      <div class="eyebrow">SIGNAL CLOSED</div>
      <h1 class="display-lg">{{ shop.name }}</h1>
      <p class="meta" style="max-width:48ch;">The frequency is not public yet. Operators check the signal log.</p>

      {%- form 'storefront_password', class: 'newsletter__form', style: 'max-width:420px;' -%}
        <label class="sr-only" for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Password" required class="newsletter__input">
        <button type="submit" class="btn btn--primary">Enter</button>
        {%- if form.errors -%}
          <p class="meta" style="color:var(--accent);">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}

      <div class="meta" style="margin-top:32px;">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
    </main>
  </body>
</html>
