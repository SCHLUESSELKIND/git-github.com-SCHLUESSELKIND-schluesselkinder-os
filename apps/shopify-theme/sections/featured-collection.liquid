{%- assign coll = collections[section.settings.collection] -%}
<section class="featured-collection section">
  <div class="wrap">
    <header class="featured-collection__header">
      <div class="featured-collection__title">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="display-md">{{ section.settings.heading | default: coll.title }}</h2>
      </div>
      {%- if coll != blank -%}
        <a href="{{ coll.url }}" class="btn featured-collection__cta">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </header>

    {%- if coll == blank -%}
      <p class="meta">{{ 'sections.featured_collection.empty' | t }}</p>
    {%- else -%}
      <div class="products-grid">
        {%- assign limit = section.settings.product_count | default: 8 -%}
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CURRENT DROP" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to collection title)" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 2, "max": 12, "step": 2, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
