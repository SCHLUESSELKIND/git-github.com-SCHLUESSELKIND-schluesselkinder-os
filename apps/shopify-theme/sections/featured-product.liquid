{%- assign p = all_products[section.settings.product] -%}
<section class="featured-collection section">
  <div class="wrap">
    <header class="featured-collection__header">
      <div class="featured-collection__title">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2 class="display-md">{{ section.settings.heading | default: p.title }}</h2>
      </div>
      {%- if p != blank -%}
        <a href="{{ p.url }}" class="btn featured-collection__cta">{{ 'sections.featured_product.view' | t }}</a>
      {%- endif -%}
    </header>

    {%- if p != blank -%}
      <div class="products-grid">
        {% render 'product-card', product: p %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SIGNAL" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to product title)" },
    { "type": "product", "id": "product", "label": "Product" }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
