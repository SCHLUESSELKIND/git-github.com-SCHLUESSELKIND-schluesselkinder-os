{%- assign p = product -%}
{%- assign current = p.selected_or_first_available_variant -%}

<section class="product section">
  <div class="wrap product__grid">
    <div class="product__media">
      {%- for media in p.media -%}
        {%- case media.media_type -%}
          {%- when 'image' -%}
            {{ media | image_url: width: 1600 | image_tag:
              loading: forloop.first ? 'eager' : 'lazy',
              fetchpriority: forloop.first ? 'high' : 'auto',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 960px) 60vw, 100vw',
              alt: media.alt | default: p.title
            }}
          {%- when 'video' -%}
            {{ media | video_tag: controls: true, loading: 'lazy' }}
          {%- when 'external_video' -%}
            {{ media | external_video_tag }}
          {%- when 'model' -%}
            {{ media | model_viewer_tag }}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="product__info">
      <div class="meta">
        {%- if p.tags contains 'limited-drop' -%}LIMITED SIGNAL — {%- endif -%}
        {%- if p.tags contains 'snuffragga-soundsystem' -%}SNUFFRAGGA SOUNDSYSTEM — {%- endif -%}
        {{ p.type | default: 'OBJECT' | upcase }}
      </div>

      <h1 class="product__title">{{ p.title }}</h1>

      <div class="product__price-row">
        <span class="product__price" data-variant-price>{{ current.price | money }}</span>
        {%- if current.compare_at_price > current.price -%}
          <span class="price price--compare">{{ current.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {%- if p.description != blank -%}
        <div class="product__description rte">{{ p.description }}</div>
      {%- endif -%}

      <form
        action="/cart/add"
        method="post"
        class="product__variants"
        enctype="multipart/form-data"
        data-variant-form
        data-variants='{{ p.variants | json | escape }}'
      >
        {%- unless p.has_only_default_variant -%}
          {%- for option in p.options_with_values -%}
            <div class="variant-group">
              <span class="variant-group__label">{{ option.name }}</span>
              <div class="variant-options" role="radiogroup" aria-label="{{ option.name }}">
                {%- for v in option.values -%}
                  {%- assign is_selected = false -%}
                  {%- if v == option.selected_value -%}{%- assign is_selected = true -%}{%- endif -%}
                  <button
                    type="button"
                    class="variant-option"
                    role="radio"
                    aria-checked="{{ is_selected }}"
                    data-variant-option
                    data-option-name="{{ option.name }}"
                    data-option-value="{{ v }}"
                  >{{ v }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ current.id }}">
        <input type="hidden" name="quantity" value="1">

        <button type="submit" class="btn btn--primary btn--block" {% unless current.available %}aria-disabled="true"{% endunless %}>
          {%- if current.available -%}
            {{ 'product.add_to_cart' | t }}
          {%- else -%}
            {{ 'product.sold_out' | t }}
          {%- endif -%}
        </button>

        <div class="product__sticky-mobile">
          <span class="price" data-variant-price>{{ current.price | money }}</span>
          <button type="submit" class="btn btn--primary btn--block" {% unless current.available %}aria-disabled="true"{% endunless %}>
            {{ 'product.add_to_cart' | t }}
          </button>
        </div>
      </form>

      <ul class="product__meta-list">
        {%- if section.settings.shipping_line != blank -%}
          <li>{{ section.settings.shipping_line }}</li>
        {%- endif -%}
        {%- if p.tags contains 'limited-drop' -%}
          <li>LIMITED DROP — STOCK NOT REPLENISHED</li>
        {%- endif -%}
        {%- if section.settings.materials_line != blank -%}
          <li>{{ section.settings.materials_line }}</li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "shipping_line", "label": "Shipping line", "default": "SHIPS WITHIN 7–14 DAYS" },
    { "type": "text", "id": "materials_line", "label": "Materials / care line" }
  ]
}
{% endschema %}
