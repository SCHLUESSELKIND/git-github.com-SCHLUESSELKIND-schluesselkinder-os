# Root environment contract for local development and deployment.
# Copy to .env locally and fill values outside Git. Do not commit real secrets.
# This file intentionally lists variable names only.

# Shared
NODE_ENV=
LOG_LEVEL=

# Web app
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_WEB_URL=
NEXT_PUBLIC_API_URL=

# Internal admin OS — server-side gate. Production must use the
# non-public variant. NEXT_PUBLIC_INTERNAL_CONSOLE_ENABLED is a local-dev
# fallback only and is never trusted in production.
INTERNAL_CONSOLE_ENABLED=
NEXT_PUBLIC_INTERNAL_CONSOLE_ENABLED=

# Basic auth gate for /admin/* in production. When NODE_ENV=production,
# both values must be set or the gate fails closed with HTTP 404.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# Upstream URL for the soundsystem inference service. Server-side only.
# The browser never sees this; admin routes proxy through
# /admin/api/soundsystem/* instead.
SOUNDSYSTEM_INFERENCE_URL=

# Legacy / local-dev only. Do NOT set this in production — it is
# browser-visible and therefore unsuitable for security.
NEXT_PUBLIC_SOUNDSYSTEM_INFERENCE_URL=

# API service
API_HOST=
API_PORT=

# SNUFFRAGA SOUNDSYSTEM inference service
SOUNDSYSTEM_INFERENCE_HOST=
SOUNDSYSTEM_INFERENCE_PORT=
SOUNDSYSTEM_INTERNAL_API_KEY=
SOUNDSYSTEM_ARTIFACT_ROOT=
SOUNDSYSTEM_REDIS_URL=
SOUNDSYSTEM_SUPABASE_URL=
SOUNDSYSTEM_SUPABASE_SERVICE_ROLE_KEY=
SOUNDSYSTEM_DROPBOX_APP_KEY=
SOUNDSYSTEM_DROPBOX_APP_SECRET=
SOUNDSYSTEM_DROPBOX_REFRESH_TOKEN=
SOUNDSYSTEM_RUNPOD_API_KEY=
SOUNDSYSTEM_OPENAI_API_KEY=
SOUNDSYSTEM_OPENAI_MODEL=
SOUNDSYSTEM_ANTHROPIC_API_KEY=
SOUNDSYSTEM_ANTHROPIC_MODEL=
ACESTEP_API_URL=
ACESTEP_API_KEY=
YUE_WORKER_URL=
STABLE_AUDIO_MODEL_PATH=

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Stripe later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printful later
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
