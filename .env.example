# Root environment contract for local development and deployment.
# Copy to .env locally and fill values outside Git. Do not commit real secrets.
# This file intentionally lists variable names only.

# Shared
NODE_ENV=
LOG_LEVEL=

# Web app
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_WEB_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_INTERNAL_CONSOLE_ENABLED=

# API service
API_HOST=
API_PORT=

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Stripe later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printful later
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
