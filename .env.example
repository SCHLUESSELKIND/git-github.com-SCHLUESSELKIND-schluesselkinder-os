# Root environment contract for local development and deployment.
# Copy to .env locally when needed. Do not commit real secrets.

# Shared
NODE_ENV=development
LOG_LEVEL=info

# Web app
NEXT_PUBLIC_APP_NAME=SCHLUESSELKINDER
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API service
API_HOST=0.0.0.0
API_PORT=3001

# Database later
DATABASE_URL=postgresql://user:password@localhost:5432/schluesselkinder

# Stripe later
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Printful later
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
