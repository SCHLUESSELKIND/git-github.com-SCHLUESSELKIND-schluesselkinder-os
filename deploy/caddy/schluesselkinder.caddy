# SCHLUESSELKINDER — Caddy server blocks for the Hetzner host.
#
# Path on server: /etc/caddy/Caddyfile  (this file is the canonical source)
# Reload:        sudo systemctl reload caddy
# Validate:      sudo caddy validate --config /etc/caddy/Caddyfile
#
# Each block terminates TLS via the Caddy auto-Let's-Encrypt flow and
# reverse-proxies to a loopback port bound by docker-compose:
#   schluesselkinder.de        → 127.0.0.1:3091  (web, Next.js)
#   www.schluesselkinder.de    → 301 → https://schluesselkinder.de$1
#   api.schluesselkinder.de    → 127.0.0.1:3092  (api, FastAPI)
#   listmonk.schluesselkinder.de → 127.0.0.1:3093 (listmonk admin + subscribe)
#
# DNS prerequisites (IONOS):
#   schluesselkinder.de        A     178.104.103.37
#   www.schluesselkinder.de    A     178.104.103.37
#   api.schluesselkinder.de    A     178.104.103.37
#   listmonk.schluesselkinder.de A   178.104.103.37
#   shop.schluesselkinder.de   CNAME shops.myshopify.com.   (Shopify — NOT this host)
#
# Operator email for Let's Encrypt is configured in the global
# `email` directive at the top of /etc/caddy/Caddyfile — keep it there.

# ---------------------------------------------------------------------------
# Public web
# ---------------------------------------------------------------------------
schluesselkinder.de {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3091
	header {
		# Security baseline. No HSTS-preload yet (gives us reversibility).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Remove the default Caddy server banner — small surface reduction.
		-Server
	}
}

# ---------------------------------------------------------------------------
# www → apex 301 redirect
# Status 308 would also work but 301 is what humans and crawlers expect
# for canonicalisation and is preserved across method changes here too
# because the redirect is for GETs only (the site is read-only).
# ---------------------------------------------------------------------------
www.schluesselkinder.de {
	redir https://schluesselkinder.de{uri} 301
}

# ---------------------------------------------------------------------------
# API (FastAPI inference + commerce + public newsletter subscribe)
# CORS is enforced INSIDE the FastAPI app (SOUNDSYSTEM_CORS_ALLOWED_ORIGINS).
# Operator endpoints require operator auth handled by the app itself.
# ---------------------------------------------------------------------------
api.schluesselkinder.de {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3092
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Keep the public API surface small. /docs is intentionally NOT
	# blocked here so operators can introspect from a trusted network;
	# revisit if we ever expose this on a less-trusted boundary.
}

# ---------------------------------------------------------------------------
# Listmonk (newsletter admin UI + subscriber API)
# Admin UI is protected by Listmonk's own admin login — the IP allow-list
# below is OPTIONAL. Uncomment and tighten if you want belt-and-suspenders.
# ---------------------------------------------------------------------------
listmonk.schluesselkinder.de {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3093
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Optional admin IP allow-list (uncomment + set):
	# @admin path /admin/* /api/*
	# handle @admin {
	# 	@allowed remote_ip <YOUR_OPERATOR_IP>
	# 	handle @allowed {
	# 		reverse_proxy 127.0.0.1:3093
	# 	}
	# 	respond 403
	# }
}
