# SCHLUESSELKINDER — production env template for docker-compose.existing-server.yml.
#
# Copy this file to `.env` on the server (next to docker-compose.existing-server.yml)
# and replace every <REPLACE> with a real value. NEVER commit `.env`.
#
# Path on server:
#   /mnt/HC_Volume_105338505/schluesselkinder/schluesselkinder-os/.env
#
# Generate random passwords on the server:
#   openssl rand -hex 32

# ---- Listmonk postgres ----
LISTMONK_DB_PASSWORD=<REPLACE_with_openssl_rand_hex_32>

# ---- Listmonk admin (UI login at https://listmonk.schluesselkinder.de) ----
LISTMONK_ADMIN_USERNAME=admin
LISTMONK_ADMIN_PASSWORD=<REPLACE_with_openssl_rand_hex_32>

# ---- Listmonk API user (created in admin UI after install) ----
# In Listmonk admin: Settings → Users → "+ New" → role "User" with API access.
# Generate a token there and paste it as LISTMONK_API_PASSWORD.
LISTMONK_API_USERNAME=snuffragga-bot
LISTMONK_API_PASSWORD=<REPLACE_with_listmonk_api_token>

# ---- Listmonk list id ----
# In Listmonk admin: Lists → "+ New" → name "SNUFFRAGGA — signal", type
# "Public", optin "Double". The id appears in the URL after save (e.g. /lists/1).
LISTMONK_API_LIST_ID=1
