# SCHLUESSELKINDER — production env template for docker-compose.existing-server.yml.
#
# Copy this file to `.env` on the server (next to docker-compose.existing-server.yml)
# and fill in the empty values. NEVER commit `.env`.
#
# IMPORTANT: this file is sourced by bash via `. ./.env`, so values MUST NOT
# contain shell metacharacters (<, >, |, &, ;, $, backtick, newline) unless
# they are quoted. The four secrets below should be hex / alphanumeric only.
#
# Path on server:
#   /mnt/HC_Volume_105338505/schluesselkinder/schluesselkinder-os/.env
#
# Generate random secrets on the server:
#   openssl rand -hex 32

# ---- Listmonk postgres ----
# Required. Generate: openssl rand -hex 32
LISTMONK_DB_PASSWORD=

# ---- Listmonk admin (UI login at https://listmonk.schluesselkinder.de) ----
# Required. Default username "admin" is fine. Generate password: openssl rand -hex 32
LISTMONK_ADMIN_USERNAME=admin
LISTMONK_ADMIN_PASSWORD=

# ---- Listmonk API user (created in admin UI AFTER first install) ----
# Optional at install time — leave empty until you complete the post-install
# steps. The API container reads these and reports
# `newsletter_listmonk_configured: false` when any are empty, which is the
# correct offline-honest behaviour.
#
# In Listmonk admin: Settings → Users → "+ New" → role "User" with API access.
# Generate a token there and paste it as LISTMONK_API_PASSWORD.
LISTMONK_API_USERNAME=
LISTMONK_API_PASSWORD=

# ---- Listmonk list id ----
# In Listmonk admin: Lists → "+ New" → name "SNUFFRAGGA — signal", type
# "Public", optin "Double". The id appears in the URL after save (e.g. /lists/1).
LISTMONK_API_LIST_ID=
