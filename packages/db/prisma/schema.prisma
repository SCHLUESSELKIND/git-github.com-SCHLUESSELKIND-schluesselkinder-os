generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtistStatus {
  ACTIVE
  ARCHIVED
  HIDDEN
}

enum ReleaseStatus {
  SIGNAL_PENDING
  ACTIVE
  CLOSED
  ARCHIVED
  HIDDEN
}

enum FragmentType {
  HERO
  MANIFEST
  METADATA
  ARTIST
  MUSIC
  OBJECT
  SOCIAL
}

enum RuleSeverity {
  REQUIRED
  WARNING
  DISCOURAGED
}

enum RuleCategory {
  CORE
  VISUAL
  LANGUAGE
  CHANNEL
  VOICE
  AUDIENCE
  SCORING
}

enum Channel {
  WEBSITE
  TIKTOK
  INSTAGRAM
  SOUNDCLOUD
  SPOTIFY
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  SYMBOL
  TEXT
  OBJECT
  MOTION
}

enum AssetSourceType {
  LOCAL_REFERENCE
  EXTERNAL_REFERENCE
  SYMBOLIC_REFERENCE
}

enum CompatibilityVerdict {
  ALLOWED
  DISCOURAGED
  FORBIDDEN
  REQUIRED
}

enum FragmentPlacement {
  HERO
  CAPTION
  METADATA
  RELEASE_NOTE
  CHANNEL_COPY
  OBJECT_ARCHIVE
}

enum ReviewStage {
  MOODBOARD_REVIEW
  CONTENT_REVIEW
  SCHEDULE_REVIEW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
  ARCHIVED
}

enum DecisionType {
  APPROVE
  REJECT
  REQUEST_REVISION
  ARCHIVE
}

enum ReviewSubjectType {
  MUSIC_RELEASE
  TRACK
  CAMPAIGN_WORLD
  ASSET
  RELEASE_FRAGMENT
  CHANNEL_FRAGMENT
  FUTURE_MOODBOARD
  FUTURE_CONTENT_ASSET
  FUTURE_SCHEDULE_PLAN
  FUTURE_CAMPAIGN
}

enum RuleViolationSource {
  BRAND_RULE
  VISUAL_RULE
  LANGUAGE_RULE
  FORBIDDEN_ENERGY
  CHANNEL_RULE
  SIGNAL_SCORING_RULE
  CONTENT_GRAPH_COMPATIBILITY
  MANUAL
}

enum GenerationBriefType {
  MOODBOARD
  CONTENT
  CHANNEL_COPY
  SCHEDULE_PLAN
}

enum GenerationRequestStatus {
  DRAFT
  READY_FOR_REVIEW
  REJECTED
  REVIEW_ACCEPTED
  ARCHIVED
}

enum GenerationOutputStatus {
  GENERATED_PLACEHOLDER
  REVIEW_REQUIRED
  REVIEW_REJECTED
  REVIEW_ARCHIVED
}

enum PromptSectionType {
  CONTEXT
  BRAND_CONSTRAINTS
  CONTENT_GRAPH
  CHANNEL_RULES
  FORBIDDEN_ENERGY
  OUTPUT_FORMAT
  REVIEW_REQUIREMENTS
}

enum ConstraintSource {
  BRAND_RULE
  VISUAL_RULE
  LANGUAGE_RULE
  FORBIDDEN_ENERGY
  CHANNEL_RULE
  SIGNAL_SCORING_RULE
  CONTENT_GRAPH_COMPATIBILITY
  REVIEW_GOVERNANCE
  MANUAL
}

enum EvaluationVerdict {
  PASS
  WARNING
  FAIL
}

model Artist {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  symbol      String
  status      ArtistStatus @default(ACTIVE)
  bioFragment String?
  createdAt   DateTime     @default(now())

  musicReleases  MusicRelease[]
  objectReleases ObjectRelease[]
  campaignWorlds ArtistCampaignWorld[]
}

model ObjectRelease {
  id              String        @id @default(cuid())
  releaseId       String        @unique
  title           String
  type            String
  status          ReleaseStatus @default(SIGNAL_PENDING)
  mark            String
  artistId        String?
  materialNote    String?
  archiveFragment String?
  createdAt       DateTime      @default(now())

  artist Artist? @relation(fields: [artistId], references: [id])
}

model MusicRelease {
  id          String        @id @default(cuid())
  artistId    String
  releaseCode String        @unique
  title       String
  status      ReleaseStatus @default(ACTIVE)
  coverImage  String?
  createdAt   DateTime      @default(now())

  artist Artist  @relation(fields: [artistId], references: [id])
  tracks Track[]

  campaignWorlds   MusicReleaseCampaignWorld[]
  releaseFragments ReleaseFragment[]
  reviewItems      ReviewItem[]
  generationBriefs GenerationBrief[]
}

model Track {
  id           String  @id @default(cuid())
  releaseId    String
  title        String
  duration     Int?
  moodFragment String?

  release MusicRelease @relation(fields: [releaseId], references: [id])

  moodReferences   TrackMoodReference[]
  releaseFragments ReleaseFragment[]
  reviewItems      ReviewItem[]
  generationBriefs GenerationBrief[]
}

model Fragment {
  id        String       @id @default(cuid())
  type      FragmentType
  language  String
  content   String
  weight    Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  releaseFragments ReleaseFragment[]
  channelFragments ChannelFragment[]
}

model BrandRule {
  id        String       @id @default(cuid())
  code      String       @unique
  category  RuleCategory
  title     String
  statement String
  severity  RuleSeverity @default(REQUIRED)
  weight    Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model VisualRule {
  id        String       @id @default(cuid())
  code      String       @unique
  title     String
  rule      String
  severity  RuleSeverity @default(REQUIRED)
  weight    Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model LanguageRule {
  id        String       @id @default(cuid())
  code      String       @unique
  title     String
  rule      String
  severity  RuleSeverity @default(REQUIRED)
  weight    Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model ForbiddenEnergy {
  id        String       @id @default(cuid())
  code      String       @unique
  label     String
  reason    String
  severity  RuleSeverity @default(REQUIRED)
  weight    Int          @default(100)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model VoiceProfile {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AudiencePersona {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  emotionalState      String
  aestheticAttraction String
  behavioralPattern   String
  rejectionPattern    String
  resonanceReason     String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model ChannelRule {
  id        String       @id @default(cuid())
  channel   Channel
  code      String       @unique
  title     String
  rule      String
  severity  RuleSeverity @default(REQUIRED)
  weight    Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
}

model SignalScoringRule {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  maxScore    Int      @default(10)
  weight      Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model CampaignWorld {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  weight      Int      @default(0)
  createdAt   DateTime @default(now())

  artists            ArtistCampaignWorld[]
  musicReleases      MusicReleaseCampaignWorld[]
  visualEnvironments CampaignWorldVisualEnvironment[]
  moodReferences     CampaignWorldMoodReference[]
  assets             CampaignWorldAsset[]
  channelFragments   ChannelFragment[]
  reviewItems        ReviewItem[]
  generationBriefs   GenerationBrief[]
}

model VisualEnvironment {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  weight      Int      @default(0)
  createdAt   DateTime @default(now())

  campaignWorlds CampaignWorldVisualEnvironment[]
}

model MoodReference {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  weight      Int      @default(0)
  createdAt   DateTime @default(now())

  tracks           TrackMoodReference[]
  campaignWorlds   CampaignWorldMoodReference[]
  channelFragments ChannelFragment[]
}

model Asset {
  id           String          @id @default(cuid())
  code         String          @unique
  type         AssetType
  sourceType   AssetSourceType
  title        String
  description  String?
  referenceKey String?
  active       Boolean         @default(true)
  weight       Int             @default(0)
  createdAt    DateTime        @default(now())

  campaignWorlds CampaignWorldAsset[]
  tags           AssetTagAssignment[]
  reviewItems    ReviewItem[]
}

model AssetTag {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assets AssetTagAssignment[]
}

model ArtistCampaignWorld {
  id              String               @id @default(cuid())
  artistId        String
  campaignWorldId String
  verdict         CompatibilityVerdict @default(ALLOWED)
  reason          String?
  weight          Int                  @default(0)

  artist        Artist        @relation(fields: [artistId], references: [id])
  campaignWorld CampaignWorld @relation(fields: [campaignWorldId], references: [id])

  @@unique([artistId, campaignWorldId])
}

model MusicReleaseCampaignWorld {
  id              String               @id @default(cuid())
  musicReleaseId  String
  campaignWorldId String
  verdict         CompatibilityVerdict @default(ALLOWED)
  reason          String?
  weight          Int                  @default(0)

  musicRelease  MusicRelease  @relation(fields: [musicReleaseId], references: [id])
  campaignWorld CampaignWorld @relation(fields: [campaignWorldId], references: [id])

  @@unique([musicReleaseId, campaignWorldId])
}

model TrackMoodReference {
  id              String               @id @default(cuid())
  trackId         String
  moodReferenceId String
  verdict         CompatibilityVerdict @default(ALLOWED)
  reason          String?
  weight          Int                  @default(0)

  track         Track         @relation(fields: [trackId], references: [id])
  moodReference MoodReference @relation(fields: [moodReferenceId], references: [id])

  @@unique([trackId, moodReferenceId])
}

model CampaignWorldVisualEnvironment {
  id                  String               @id @default(cuid())
  campaignWorldId     String
  visualEnvironmentId String
  verdict             CompatibilityVerdict @default(ALLOWED)
  reason              String?
  weight              Int                  @default(0)

  campaignWorld     CampaignWorld     @relation(fields: [campaignWorldId], references: [id])
  visualEnvironment VisualEnvironment @relation(fields: [visualEnvironmentId], references: [id])

  @@unique([campaignWorldId, visualEnvironmentId])
}

model CampaignWorldMoodReference {
  id              String               @id @default(cuid())
  campaignWorldId String
  moodReferenceId String
  verdict         CompatibilityVerdict @default(ALLOWED)
  reason          String?
  weight          Int                  @default(0)

  campaignWorld CampaignWorld @relation(fields: [campaignWorldId], references: [id])
  moodReference MoodReference @relation(fields: [moodReferenceId], references: [id])

  @@unique([campaignWorldId, moodReferenceId])
}

model CampaignWorldAsset {
  id              String               @id @default(cuid())
  campaignWorldId String
  assetId         String
  verdict         CompatibilityVerdict @default(ALLOWED)
  reason          String?
  weight          Int                  @default(0)

  campaignWorld CampaignWorld @relation(fields: [campaignWorldId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])

  @@unique([campaignWorldId, assetId])
}

model AssetTagAssignment {
  id      String @id @default(cuid())
  assetId String
  tagId   String
  weight  Int    @default(0)

  asset Asset    @relation(fields: [assetId], references: [id])
  tag   AssetTag @relation(fields: [tagId], references: [id])

  @@unique([assetId, tagId])
}

model ReleaseFragment {
  id             String            @id @default(cuid())
  fragmentId     String
  musicReleaseId String?
  trackId        String?
  placement      FragmentPlacement
  weight         Int               @default(0)
  active         Boolean           @default(true)

  fragment     Fragment      @relation(fields: [fragmentId], references: [id])
  musicRelease MusicRelease? @relation(fields: [musicReleaseId], references: [id])
  track        Track?        @relation(fields: [trackId], references: [id])
  reviewItems  ReviewItem[]

  @@index([musicReleaseId])
  @@index([trackId])
}

model ChannelFragment {
  id              String            @id @default(cuid())
  fragmentId      String
  channel         Channel
  campaignWorldId String?
  moodReferenceId String?
  placement       FragmentPlacement
  weight          Int               @default(0)
  active          Boolean           @default(true)

  fragment         Fragment          @relation(fields: [fragmentId], references: [id])
  campaignWorld    CampaignWorld?    @relation(fields: [campaignWorldId], references: [id])
  moodReference    MoodReference?    @relation(fields: [moodReferenceId], references: [id])
  reviewItems      ReviewItem[]
  generationBriefs GenerationBrief[]

  @@index([channel])
  @@index([campaignWorldId])
  @@index([moodReferenceId])
}

model ReviewItem {
  id                String            @id @default(cuid())
  reviewKey         String            @unique
  stage             ReviewStage
  status            ReviewStatus      @default(PENDING)
  subjectType       ReviewSubjectType
  subjectKey        String
  title             String
  summary           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  musicReleaseId    String?
  trackId           String?
  campaignWorldId   String?
  assetId           String?
  releaseFragmentId String?
  channelFragmentId String?

  musicRelease      MusicRelease?      @relation(fields: [musicReleaseId], references: [id])
  track             Track?             @relation(fields: [trackId], references: [id])
  campaignWorld     CampaignWorld?     @relation(fields: [campaignWorldId], references: [id])
  asset             Asset?             @relation(fields: [assetId], references: [id])
  releaseFragment   ReleaseFragment?   @relation(fields: [releaseFragmentId], references: [id])
  channelFragment   ChannelFragment?   @relation(fields: [channelFragmentId], references: [id])
  decisions         ApprovalDecision[]
  comments          ApprovalComment[]
  violations        RuleViolation[]
  generationBriefs  GenerationBrief[]
  generationOutputs GenerationOutput[]

  @@index([stage, status])
  @@index([subjectType, subjectKey])
}

model ApprovalDecision {
  id           String       @id @default(cuid())
  reviewItemId String
  type         DecisionType
  note         String?
  decidedBy    String?
  createdAt    DateTime     @default(now())

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id])

  @@index([reviewItemId, createdAt])
}

model ApprovalComment {
  id           String   @id @default(cuid())
  reviewItemId String
  body         String
  author       String?
  createdAt    DateTime @default(now())

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id])

  @@index([reviewItemId, createdAt])
}

model RuleViolation {
  id           String              @id @default(cuid())
  reviewItemId String
  source       RuleViolationSource
  ruleCode     String?
  title        String
  detail       String
  severity     RuleSeverity        @default(WARNING)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())

  reviewItem ReviewItem @relation(fields: [reviewItemId], references: [id])

  @@index([reviewItemId])
  @@index([source, ruleCode])
}

model ConstraintBundle {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  constraints GenerationBriefConstraint[]
  briefs      GenerationBrief[]
}

model GenerationBriefConstraint {
  id          String           @id @default(cuid())
  bundleId    String
  source      ConstraintSource
  ruleCode    String?
  title       String
  instruction String
  required    Boolean          @default(true)
  weight      Int              @default(0)
  active      Boolean          @default(true)

  bundle ConstraintBundle @relation(fields: [bundleId], references: [id])

  @@index([source, ruleCode])
}

model ChannelCompositionProfile {
  id          String   @id @default(cuid())
  code        String   @unique
  channel     Channel
  name        String
  description String
  outputShape String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  briefs GenerationBrief[]
}

model GenerationBrief {
  id                          String              @id @default(cuid())
  briefKey                    String              @unique
  type                        GenerationBriefType
  title                       String
  objective                   String
  subjectType                 ReviewSubjectType
  subjectKey                  String
  channel                     Channel?
  constraintBundleId          String
  reviewItemId                String?
  musicReleaseId              String?
  trackId                     String?
  campaignWorldId             String?
  channelFragmentId           String?
  channelCompositionProfileId String?
  createdAt                   DateTime            @default(now())

  constraintBundle          ConstraintBundle           @relation(fields: [constraintBundleId], references: [id])
  reviewItem                ReviewItem?                @relation(fields: [reviewItemId], references: [id])
  musicRelease              MusicRelease?              @relation(fields: [musicReleaseId], references: [id])
  track                     Track?                     @relation(fields: [trackId], references: [id])
  campaignWorld             CampaignWorld?             @relation(fields: [campaignWorldId], references: [id])
  channelFragment           ChannelFragment?           @relation(fields: [channelFragmentId], references: [id])
  channelCompositionProfile ChannelCompositionProfile? @relation(fields: [channelCompositionProfileId], references: [id])
  promptSections            PromptSection[]
  requests                  GenerationRequest[]

  @@index([subjectType, subjectKey])
}

model PromptSection {
  id       String            @id @default(cuid())
  briefId  String
  type     PromptSectionType
  title    String
  body     String
  position Int               @default(0)
  locked   Boolean           @default(true)

  brief GenerationBrief @relation(fields: [briefId], references: [id])

  @@index([briefId, position])
}

model GenerationRequest {
  id           String                  @id @default(cuid())
  requestKey   String                  @unique
  briefId      String
  status       GenerationRequestStatus @default(DRAFT)
  requestedFor String?
  notes        String?
  createdAt    DateTime                @default(now())

  brief   GenerationBrief    @relation(fields: [briefId], references: [id])
  outputs GenerationOutput[]
}

model GenerationOutput {
  id           String                 @id @default(cuid())
  outputKey    String                 @unique
  requestId    String
  reviewItemId String
  status       GenerationOutputStatus @default(REVIEW_REQUIRED)
  title        String
  placeholder  String
  createdAt    DateTime               @default(now())

  request     GenerationRequest            @relation(fields: [requestId], references: [id])
  reviewItem  ReviewItem                   @relation(fields: [reviewItemId], references: [id])
  evaluations GenerationOutputEvaluation[]

  @@index([reviewItemId])
}

model GenerationOutputEvaluation {
  id        String            @id @default(cuid())
  outputId  String
  source    ConstraintSource
  ruleCode  String?
  verdict   EvaluationVerdict
  title     String
  detail    String
  createdAt DateTime          @default(now())

  output GenerationOutput @relation(fields: [outputId], references: [id])

  @@index([source, ruleCode])
}
